{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-dangerous.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/block-on-pushback.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/require-ci-pass.js"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/require-plan.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/block-on-pushback.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/block-archived.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/block-infra-edit.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/manager-stop.js"
          }
        ]
      }
    ]
  }
}
